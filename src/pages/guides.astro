---
import AdSenseBlock from '../components/AdSenseBlock.astro';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const topicSections = [
  {
    id: 'setup-planning',
    label: 'Setup & Planning',
    categories: ['Aquarium Setup & Planning', 'Planning', 'Setup & Maintenance']
  },
  {
    id: 'equipment-technology',
    label: 'Equipment & Technology',
    categories: ['Equipment & Technology', 'Equipment']
  },
  {
    id: 'water-quality-maintenance',
    label: 'Water Quality & Maintenance',
    categories: ['Water Quality & Maintenance']
  },
  {
    id: 'fish-invertebrate-care',
    label: 'Fish & Invertebrate Care',
    categories: ['Fish & Invertebrate Care', 'Freshwater Fish']
  },
  {
    id: 'plants-aquascaping',
    label: 'Plants & Aquascaping',
    categories: ['Plants & Aquascaping']
  },
  {
    id: 'health-troubleshooting',
    label: 'Health & Troubleshooting',
    categories: ['Health & Troubleshooting']
  },
  {
    id: 'specialty-advanced-care',
    label: 'Specialty & Advanced Care',
    categories: ['Specialty & Advanced Care']
  },
  {
    id: 'automation-sustainability-upgrades',
    label: 'Automation, Sustainability & Upgrades',
    categories: ['Automation, Sustainability & Upgrades']
  }
];

const sections = topicSections
  .map((section) => ({
    ...section,
    liveGuides: guides.filter((guide) => section.categories.includes(guide.data.category))
  }))
  .filter((section) => section.liveGuides.length > 0);

const guidesHubAdSlot = import.meta.env.PUBLIC_ADSENSE_GUIDES_HUB_SLOT;
---

<Layout
  title="Aquarium Guides • Setup, Cycling, and Tank Care"
  description="Browse aquarium guides covering beginner tank setup, maintenance, cycling, equipment, and common home aquarium problems."
  ogImage="/images/og/guides.svg"
>
  <main class="max-w-6xl mx-auto px-6 py-10">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="font-bold tracking-tight text-primary">Guides</h1>
        <p class="mt-2 max-w-xl text-slate-600 dark:text-slate-300">
          Practical, no-fluff aquarium guides for setup, water quality, fish care, and equipment.
          New here? <a href="/start-here" class="font-medium text-primary underline underline-offset-2 hover:text-accent-1">Start with the beginner path</a>.
        </p>
      </div>
      <div class="w-full max-w-xs">
        <label for="guide-search" class="sr-only">Search guides</label>
        <input
          id="guide-search"
          type="search"
          placeholder="Search guides"
          class="w-full rounded-full border border-primary/15 bg-white px-4 py-2.5 text-sm text-slate-900 outline-none transition-colors focus:border-primary dark:border-white/10 dark:bg-slate-900 dark:text-white"
        />
      </div>
    </div>

    <div class="mb-8 flex flex-wrap gap-2">
      <button type="button" class="guide-filter-pill rounded-full px-4 py-1.5 text-sm font-medium transition-colors" data-filter="all" aria-pressed="true">
        All
      </button>
      {sections.map((section) => (
        <button type="button" class="guide-filter-pill rounded-full px-4 py-1.5 text-sm font-medium transition-colors" data-filter={section.id} aria-pressed="false">
          {section.label}
        </button>
      ))}
    </div>

    <AdSenseBlock className="mb-8 shadow-[0_24px_80px_-60px_rgba(1,133,174,0.35)]" label="Advertisement" slot={guidesHubAdSlot} />

    <div id="guide-empty-state" class="mb-10 hidden rounded-2xl border border-dashed border-primary/20 bg-white/70 px-6 py-7 text-center text-slate-600 shadow-[0_24px_80px_-60px_rgba(1,133,174,0.35)] dark:border-primary/20 dark:bg-slate-900/75 dark:text-slate-300">
      No guides matched that search. Try a broader term like <span class="font-semibold text-primary">betta</span>, <span class="font-semibold text-primary">filter</span>, or <span class="font-semibold text-primary">beginner</span>.
    </div>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-3">
      {guides.map((guide) => {
        const section = sections.find((s) => s.categories.includes(guide.data.category));
        return (
          <a
            href={`/guides/${guide.id}`}
            class="guide-card group overflow-hidden rounded-2xl bg-white shadow-md transition-all hover:-translate-y-0.5 hover:shadow-xl dark:bg-slate-900"
            data-title={guide.data.title.toLowerCase()}
            data-category={guide.data.category.toLowerCase()}
            data-description={guide.data.description.toLowerCase()}
            data-section={section?.id ?? ''}
          >
            <div class="relative aspect-[4/3] w-full overflow-hidden bg-light-bg dark:bg-slate-800">
              {guide.data.heroImage && (
                <img
                  src={guide.data.heroImage}
                  alt={guide.data.heroImageAlt || guide.data.title}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              )}
              <span class="absolute left-3 top-3 rounded-full bg-slate-900/85 px-3 py-1 text-xs font-semibold text-white">
                {guide.data.category}
              </span>
            </div>
            <div class="p-4">
              <h3 class="font-semibold leading-snug text-primary transition-colors group-hover:text-accent-1">{guide.data.title}</h3>
              <p class="mt-2 line-clamp-2 text-sm text-warm-neutral">{guide.data.description}</p>
            </div>
          </a>
        );
      })}
    </div>
  </main>
</Layout>

<style>
  .guide-filter-pill {
    background: color-mix(in srgb, var(--color-primary) 8%, white);
    color: var(--color-primary);
  }
  :global(.dark) .guide-filter-pill {
    background: rgb(2 6 23);
    color: rgb(226 232 240);
  }
  .guide-filter-pill[aria-pressed='true'] {
    background: var(--color-primary);
    color: white;
  }
</style>

<script>
  const searchInput = document.getElementById('guide-search') as HTMLInputElement | null;
  const filterPills = Array.from(document.querySelectorAll<HTMLButtonElement>('.guide-filter-pill'));
  const guideCards = Array.from(document.querySelectorAll<HTMLElement>('.guide-card'));
  const emptyState = document.getElementById('guide-empty-state');

  let activeFilter = 'all';

  const applyFilters = () => {
    const query = (searchInput?.value ?? '').trim().toLowerCase();
    let visibleCards = 0;

    guideCards.forEach((card) => {
      const haystack = [card.dataset.title || '', card.dataset.category || '', card.dataset.description || ''].join(' ');
      const matchesQuery = query === '' || haystack.includes(query);
      const matchesFilter = activeFilter === 'all' || card.dataset.section === activeFilter;
      const visible = matchesQuery && matchesFilter;
      card.classList.toggle('hidden', !visible);
      if (visible) visibleCards += 1;
    });

    emptyState?.classList.toggle('hidden', visibleCards > 0);
  };

  searchInput?.addEventListener('input', applyFilters);

  filterPills.forEach((pill) => {
    pill.addEventListener('click', () => {
      activeFilter = pill.dataset.filter || 'all';
      filterPills.forEach((p) => p.setAttribute('aria-pressed', String(p === pill)));
      applyFilters();
    });
  });
</script>
